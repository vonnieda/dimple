import { Button, VerticalBox , ScrollView} from "std-widgets.slint";
import { Card, CardAdapter } from "card.slint";
import { Styles, Navigator, Label, AppState, SectionTitle, SectionSubtitle } from "../common.slint";
import {StyleMetrics, HorizontalBox, Palette, TabWidget} from "std-widgets.slint";
import { PopupMenu, PopupMenuButton } from "popup_menu.slint";
import { Link } from "link.slint";

export struct CardSectionAdapter {
    url: string,
    title: string,
    sub-title: string,
    cards: [CardAdapter],    
    max-rows: int,
}

export struct CardGridAdapter {
    cards: [CardAdapter],
}

// TODO Need to change card to set overflow and wrap, or maybe just overflow.
export component VirtualCardGrid inherits Rectangle {
    in-out property <[CardAdapter]> cards;

    in property <length> card-width: Styles.thumbnail-width-large;
    in property <length> card-height: Styles.thumbnail-width-large + (Styles.default-font-size * 4.5);
    in property <length> spacing: StyleMetrics.layout-spacing;

    // Calculate grid dimensions
    property <length> grid-width: self.width;
    property <int> actual-columns: Math.max(1, Math.floor((grid-width - spacing) / (card-width + spacing)));
    property <int> rows: Math.ceil(cards.length / actual-columns);
    property <length> total-height: rows * (card-height + spacing) + spacing;

    min-height: card-height;
    preferred-height: total-height;

    ScrollView {
        width: 100%;
        height: 100%;
        
        viewport-height: total-height;
        viewport-width: self.width;

        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        
        // Container for the virtual content
        Rectangle {
            width: parent.viewport-width;
            height: parent.viewport-height;
            
            // Calculate visible range
            property <int> visible-start-row: Math.floor(-parent.viewport-y / (card-height + spacing));
            property <int> visible-end-row: Math.ceil((-parent.viewport-y + parent.height) / (card-height + spacing));
            property <int> visible-rows: visible-end-row - visible-start-row + 1;
            property <int> first-visible-index: visible-start-row * actual-columns;
            property <int> last-visible-index: Math.min(cards.length - 1, (visible-end-row + 1) * actual-columns - 1);
            
            // Render only visible cards
            for row in visible-rows: Rectangle {
                y: (visible-start-row + row) * (card-height + spacing) + spacing;
                x: spacing;
                width: parent.width - 2 * spacing;
                height: card-height;
                
                HorizontalLayout {
                    spacing: root.spacing;
                    
                    for col in actual-columns: Rectangle {
                        property <int> item-index: (visible-start-row + row) * actual-columns + col;
                        
                        if item-index < cards.length: Card {
                            width: card-width;
                            height: card-height;
                            model: cards[item-index];
                        }
                    }
                }
            }
        }
    }
}

export component CardGrid inherits VerticalBox {
    in-out property <[CardAdapter]> cards: cards_ph;
    in property <int> max-rows: 0;
    in property <length> card-width: Styles.thumbnail-width-large;

    property <int> cols: Math.max(1, Math.floor(self.width / (self.card-width + self.spacing)));
    property <int> rows: self.max-rows >= 1 ? self.max-rows : Math.ceil(cards.length / cols);
    // property <length> addl-spacing: (self.width - ((self.card-width + self.spacing) * cols)) / cols;

    alignment: start;
    padding: 0;

    for row in rows: HorizontalBox {
        alignment: start;
        padding: 0;
        for col in Math.min(cols, cards.length - (row * cols)): Card {
            // width: root.card-width + addl-spacing;
            model: cards[row * cols + col];
        }
    }

    property <CardAdapter> card_ph: {
        image: {image: @image-url("../../icons/phosphor/PNGs/regular/vinyl-record.png"),name: "A Reign of Fish",url: "internal://release/1234"},
        title: {name: "A Reign of Fish",url: "internal://release/1234"},
        sub-title: {name: "Fresh Pliers",url: "internal://artist/9876"},
    };

    property <CardAdapter> card_ph2: {
        image: {image: @image-url("../../icons/phosphor/PNGs/regular/users-three.png"),name: "Bob The Wonderful Explorer",url: "internal://release/1234"},
        title: {name: "Bob The Wonderful Explorer",url: "internal://release/1234"},
        sub-title: {name: "A man of infinite stories and very few talents.",url: "internal://artist/9876"},
    };

    property <[CardAdapter]> cards_ph: [card_ph, card_ph2, card_ph, card_ph2, card_ph2, card_ph, card_ph, card_ph2, card_ph2, card_ph2, card_ph, card_ph, card_ph, card_ph2, card_ph];
}

