import { Styles } from "../common.slint";
import { Palette } from "std-widgets.slint";
import { LazyImage } from "lazy_image.slint";

export component BorderImage inherits TouchArea {
    in property <string> key;
    // TODO chasing down putting placeholder everywhere for now, cause quick
    // but right solution is just using a placeholder KEY and we punch in the
    // various placeholders at runtime. 
    in property <image> placeholder;
    in property <brush> placeholder-colorize;
    in property <brush> background;
    mouse-cursor: MouseCursor.pointer;
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: Styles.thumbnail-border-radius;
        border-color: Palette.border;
        border-width: Styles.thumbnail-border-width;
        clip: true;
        background <=> root.background;
        LazyImage {
            width: root.width;
            height: root.height;
            key: root.key;
            placeholder <=> root.placeholder;
            placeholder-colorize <=> root.placeholder-colorize;
        }
    }
}
