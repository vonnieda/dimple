import { StyleMetrics , VerticalBox} from "std-widgets.slint";

export global Styles  {
    in-out property <string> default-font-family: "Open Sans";
    in-out property <string> text-block-font-family: "Inter";
    in-out property <length> default-font-size: 16px;
    in-out property<int> default-font-weight: 400;

    in-out property<int> font-weight-bold: 700;
    in-out property<int> font-weight-light: 100;

    in-out property<length> thumbnail-width-sidebar: 48px;

    in-out property<length> icon-width-sidebar: 28px;

    in-out property<length> thumbnail-width-small: 70px;
    in-out property<length> thumbnail-width-medium: 120px;
    in-out property<length> thumbnail-width-large: 200px;
    in-out property<length> thumbnail-width-extra-large: 275px;
    in-out property<length> thumbnail-border-radius: 5px;
    in-out property<length> thumbnail-border-width: 1px;

    in-out property <[brush]> card-placeholder-colorizes: [
        @linear-gradient(45deg, #FF6B6B 0%, #4ECDC4 100%),
        @linear-gradient(135deg, #667eea 0%, #764ba2 100%),
        @linear-gradient(90deg, #f093fb 0%, #f5576c 100%),
        @linear-gradient(45deg, #4facfe 0%, #00f2fe 100%),
        @linear-gradient(135deg, #43e97b 0%, #38f9d7 100%),
        @linear-gradient(90deg, #fa709a 0%, #fee140 100%),
        @linear-gradient(0deg, #a8edea 0%, #fed6e3 100%),
        @linear-gradient(45deg, #ff9a9e 0%, #fecfef 100%),
        @linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%),
        @linear-gradient(90deg, #ff8a80 0%, #ea80fc 100%),
        @linear-gradient(180deg, #FBAB7E 0%, #F7CE68 100%),
        @linear-gradient(45deg, #8BC6EC 0%, #9599E2 100%),
        @linear-gradient(90deg, #FFDEE9 0%, #B5FFFC 100%),
        @linear-gradient(135deg, #FEC163 0%, #DE4313 100%),
        @linear-gradient(0deg, #92FE9D 0%, #00C9FF 100%),
        @linear-gradient(45deg, #FC466B 0%, #3F5EFB 100%),
        @linear-gradient(90deg, #FDBB2D 0%, #22C1C3 100%),
        @linear-gradient(180deg, #A9C9FF 0%, #FFBBEC 100%),
        @linear-gradient(135deg, #FEE77A 0%, #F97794 100%),
        @linear-gradient(45deg, #21D4FD 0%, #B721FF 100%),
    ];
}

export global Navigator {
    callback navigate(string) -> {
        
    };
    callback url() -> string;
    in-out property <bool> busy;
}

export global AppState {
    callback player_previous();
    callback player_play_pause();
    callback player_next();
    callback player_seek(int);

    callback play_next(key: string);
    callback play_now(key: string);
    callback play_later(key: string);    

    // TODO okay add a busy activity model here, that will contain bools that say
    // some "thing" is happening. And it could even have status. And jobs will
    // set and reset those as they work so the UI can react. 
    // I guess could just tie directly to know job names.
}

export component Label inherits Text {
    font-size: Styles.default-font-size;
    font-family: Styles.default-font-family;
    font-weight: Styles.default-font-weight;
    wrap: word-wrap;
}

export component PageTitle inherits Label {
    font-size: Styles.default-font-size * 3;
    wrap: word-wrap;
}

export component PageSubtitle inherits Label {
    font-italic: true;
}

export component SectionTitle inherits Label {
    font-size: Styles.default-font-size * 2;
}

export component SectionSubtitle inherits Label {
    font-italic: true;
}

